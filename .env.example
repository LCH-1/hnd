# Host-side listen address. Keep this on loopback when nginx runs on this host.
HND_BIND_ADDRESS=127.0.0.1
HND_PORT=8787
HND_TRUST_PROXY=true

# Public HTTPS origin used by passkeys. RP ID must exactly match its hostname.
HND_PUBLIC_ORIGIN=https://hnd.example.com
HND_WEBAUTHN_RP_ID=hnd.example.com

# open lets each visitor create an isolated account and workspace without an invitation.
# Use invite/disabled to restrict registration, or first-user for legacy bootstrap behavior.
HND_SIGNUP_MODE=open

# Retained encrypted revisions per tenant (1-10000).
HND_SERVER_MAX_REVISIONS=50

# Optional local image tag.
HND_IMAGE=hnd-server:local
